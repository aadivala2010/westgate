# Contact form delivery. Without RESEND_API_KEY the form returns an error and
# the lead is only written to the function log — do not launch in that state.
#
# 1. Create a key at https://resend.com/api-keys
# 2. Add these in Vercel under Settings > Environment Variables
# 3. Redeploy

RESEND_API_KEY=

# Must be a domain verified on the Resend account. Until westgatemowing.com is
# verified, "Westgate Mowing <onboarding@resend.dev>" works for testing.
CONTACT_FROM=

# Where leads land. Defaults to site.email in content/site.ts.
CONTACT_TO=
